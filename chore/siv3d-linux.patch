@@ -14,6 +14,7 @@
 # include <Siv3D/Unicode.hpp>
 # include <Siv3D/Char.hpp>
 # include <Siv3D/UserAction.hpp>
+# include <Siv3D/Time.hpp>
 # include <Siv3D/Window/IWindow.hpp>
 # include <Siv3D/UserAction/IUserAction.hpp>
 # include <Siv3D/Common/Siv3DEngine.hpp>
@@ -158,6 +159,32 @@ namespace s3d
 			{ 0xE2, SIV3D_KEY_JIS_UNDERSCORE }, // _ (JIS)
 		};
 
+		Array<KeyEvent> KeyEvents;
+		uint32 KeyEventIndex = 0;
+		GLFWkeyfun PreviousKeyCallback = nullptr;
+		void CaptureKeyEvent(GLFWwindow* window, int key, int scanCode, int action, int modifiers)
+		{
+			if (action != GLFW_REPEAT)
+			{
+				for (auto [code, glfwKey] : KeyConversionTable)
+				{
+					if (glfwKey != 0 && glfwKey == key)
+					{
+						KeyEvents << KeyEvent{Time::GetMillisec(), ++KeyEventIndex, code, action == GLFW_PRESS, action == GLFW_RELEASE};
+					}
+				}
+				const uint8 modifierCode = ((key == GLFW_KEY_LEFT_SHIFT || key == GLFW_KEY_RIGHT_SHIFT) ? 0x10
+					: (key == GLFW_KEY_LEFT_CONTROL || key == GLFW_KEY_RIGHT_CONTROL) ? 0x11
+					: (key == GLFW_KEY_LEFT_ALT || key == GLFW_KEY_RIGHT_ALT) ? 0x12 : 0);
+				if (modifierCode != 0)
+				{
+					KeyEvents << KeyEvent{Time::GetMillisec(), ++KeyEventIndex, modifierCode, action == GLFW_PRESS, action == GLFW_RELEASE};
+				}
+				while (KeyEvents.size() > 128) { KeyEvents.erase(KeyEvents.begin()); }
+			}
+			if (PreviousKeyCallback) { PreviousKeyCallback(window, key, scanCode, action, modifiers); }
+		}
+

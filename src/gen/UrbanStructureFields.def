URBAN_FIELD(double, minimumRelief, 0, 2000)
URBAN_FIELD(double, shoreRange, 0, 10000)
URBAN_FIELD(double, extentX, 300, 1800)
URBAN_FIELD(double, extentZ, 250, 1800)
URBAN_FIELD(double, spacingX, 45, 200)
URBAN_FIELD(double, spacingZ, 45, 200)
URBAN_FIELD(double, cubicWeight, 0, 0.4)
URBAN_FIELD(int, collectorEvery, 2, 8)
URBAN_FIELD(int, staggerEvery, 0, 8)
URBAN_FIELD(double, ringRatio, 0, 0.85)
URBAN_FIELD(int, crossBoulevard, 0, 1)
URBAN_FIELD(double, backgroundIntensity, 0, 1)
URBAN_FIELD(double, outerOccupancy, 0.1, 1)
URBAN_FIELD(double, coreFrontage, 10, 30)
URBAN_FIELD(double, outerFrontage, 12, 40)
URBAN_FIELD(double, coreHighShare, 0, 1)
URBAN_FIELD(double, coreOfficeShare, 0, 1)
URBAN_FIELD(double, coreMidShare, 0, 1)
URBAN_FIELD(double, innerDetachedShare, 0, 1)
URBAN_FIELD(double, outerDetachedShare, 0, 1)
URBAN_FIELD(double, housingMidShare, 0, 1)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pavecity generation: network",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "localRoutingCell",
    "longRouteThreshold",
    "longRoutingCell",
    "mediumRouteThreshold",
    "mediumRoutingCell",
    "occupiedCell",
    "routingMargin",
    "denseSampleThreshold",
    "borderInset",
    "cityJoinRadius",
    "townJoinRadius",
    "villageJoinRadius",
    "fallbackJoinRadius",
    "villageDirectJoinDistance",
    "mountainRoadSideSample",
    "mountainRoadRelief",
    "minimumKaidoSearchRadius",
    "kaidoSearchRadiusScale",
    "regionalNeighbors",
    "regionalNeighborRadius",
    "regionalCandidateLimit",
    "regionalRoutingAttemptLimit",
    "regionalExtraLinks",
    "regionalAccessRadius",
    "regionalCorridorMergeDistance",
    "regionalDetourRatio",
    "regionalMinimumSavedDistance",
    "regionalMinimumSavingRatio",
    "regionalMaximumCostRatio",
    "mountainRouteCount",
    "mountainRouteRelief",
    "mountainRouteProbe",
    "mountainRouteMinimumLength",
    "mountainRouteGapTolerance",
    "mountainRouteWaypointSpacing",
    "mountainRouteBankOffset",
    "mountainRouteSideSwitch",
    "mountainRouteJoinRadius",
    "mountainRouteBorderReach",
    "mountainRouteBasinReach"
  ],
  "properties": {
    "localRoutingCell": {
      "type": "number",
      "minimum": 8.0,
      "maximum": 200.0
    },
    "longRouteThreshold": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "longRoutingCell": {
      "type": "number",
      "minimum": 8.0,
      "maximum": 400.0
    },
    "mediumRouteThreshold": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "mediumRoutingCell": {
      "type": "number",
      "minimum": 8.0,
      "maximum": 400.0
    },
    "occupiedCell": {
      "type": "number",
      "minimum": 8.0,
      "maximum": 500.0
    },
    "routingMargin": {
      "type": "number",
      "minimum": 10.0,
      "maximum": 5000.0
    },
    "denseSampleThreshold": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "borderInset": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 100.0
    },
    "cityJoinRadius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "townJoinRadius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "villageJoinRadius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "fallbackJoinRadius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "villageDirectJoinDistance": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "mountainRoadSideSample": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "mountainRoadRelief": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "minimumKaidoSearchRadius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0
    },
    "kaidoSearchRadiusScale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10.0
    },
    "regionalNeighbors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "regionalNeighborRadius": {
      "type": "number",
      "minimum": 500,
      "maximum": 15000
    },
    "regionalCandidateLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "regionalRoutingAttemptLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "regionalExtraLinks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "regionalAccessRadius": {
      "type": "number",
      "minimum": 100,
      "maximum": 2000
    },
    "regionalCorridorMergeDistance": {
      "type": "number",
      "minimum": 50,
      "maximum": 1000
    },
    "regionalDetourRatio": {
      "type": "number",
      "minimum": 1.1,
      "maximum": 5
    },
    "regionalMinimumSavedDistance": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000
    },
    "regionalMinimumSavingRatio": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 0.8
    },
    "regionalMaximumCostRatio": {
      "type": "number",
      "minimum": 1,
      "maximum": 64
    },
    "mountainRouteCount": {
      "type": "integer",
      "minimum": 0.0,
      "maximum": 8.0
    },
    "mountainRouteRelief": {
      "type": "number",
      "minimum": 10.0,
      "maximum": 2000.0
    },
    "mountainRouteProbe": {
      "type": "number",
      "minimum": 50.0,
      "maximum": 3000.0
    },
    "mountainRouteMinimumLength": {
      "type": "number",
      "minimum": 500.0,
      "maximum": 60000.0
    },
    "mountainRouteGapTolerance": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5000.0
    },
    "mountainRouteWaypointSpacing": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 5000.0
    },
    "mountainRouteBankOffset": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 300.0
    },
    "mountainRouteSideSwitch": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 500.0
    },
    "mountainRouteJoinRadius": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 40000.0
    },
    "mountainRouteBorderReach": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 40000.0
    },
    "mountainRouteBasinReach": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 60000.0
    }
  }
}

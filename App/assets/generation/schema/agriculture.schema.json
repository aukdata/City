{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pavecity generation: agriculture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plotLength",
    "plotWidth",
    "trackWidth",
    "paddyRelief",
    "sampleStep",
    "maximumTrackGrade",
    "minimumFreeboard",
    "maximumFieldRelief",
    "dryFieldDivisor",
    "surfaceLift",
    "bundWidth",
    "drainWidth",
    "accessSpacing",
    "trackStep",
    "trackReach",
    "densityRadius",
    "maximumRadius",
    "homeSpacing",
    "homeMaximumDistance",
    "minimumFieldArea",
    "fieldShapeVariation",
    "trackTurnPenalty",
    "trackDirectionPenalty",
    "trackHeadingStep",
    "maximumTrackCutFill",
    "densityFalloff",
    "minimumDensity",
    "rootSpacingRatio",
    "minimumReachRatio",
    "homeSetback",
    "homeFootprintMargin",
    "connectionRadius",
    "deadEndConnectionRadius",
    "meanderAngle",
    "meanderWavelength"
  ],
  "properties": {
    "plotLength": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 1000.0
    },
    "plotWidth": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 1000.0
    },
    "trackWidth": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 1000.0
    },
    "paddyRelief": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "sampleStep": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 64.0
    },
    "maximumTrackGrade": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 0.2
    },
    "minimumFreeboard": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "maximumFieldRelief": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "dryFieldDivisor": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 100.0
    },
    "surfaceLift": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "bundWidth": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5.0
    },
    "drainWidth": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5.0
    },
    "accessSpacing": {
      "type": "number",
      "minimum": 64.0,
      "maximum": 1000.0
    },
    "trackStep": {
      "type": "number",
      "minimum": 24.0,
      "maximum": 160.0
    },
    "trackReach": {
      "type": "number",
      "minimum": 72.0,
      "maximum": 2000.0
    },
    "densityRadius": {
      "type": "number",
      "minimum": 200.0,
      "maximum": 5000.0
    },
    "maximumRadius": {
      "type": "number",
      "minimum": 300.0,
      "maximum": 10000.0
    },
    "homeSpacing": {
      "type": "number",
      "minimum": 80.0,
      "maximum": 400.0
    },
    "homeMaximumDistance": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 500.0
    },
    "minimumFieldArea": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 3000.0
    },
    "fieldShapeVariation": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.5
    },
    "trackTurnPenalty": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "trackDirectionPenalty": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "trackHeadingStep": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 0.5
    },
    "maximumTrackCutFill": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5.0
    },
    "densityFalloff": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 3.0
    },
    "minimumDensity": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.5
    },
    "rootSpacingRatio": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 1.0
    },
    "minimumReachRatio": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 1.0
    },
    "homeSetback": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 20.0
    },
    "homeFootprintMargin": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10.0
    },
    "connectionRadius": {
      "type": "number",
      "minimum": 2.0,
      "maximum": 100.0
    },
    "deadEndConnectionRadius": {
      "type": "number",
      "minimum": 80.0,
      "maximum": 500.0
    },
    "meanderAngle": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.7
    },
    "meanderWavelength": {
      "type": "number",
      "minimum": 200.0,
      "maximum": 1200.0
    }
  }
}

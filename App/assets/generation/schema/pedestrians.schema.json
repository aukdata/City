{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pavecity generation: pedestrians",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetPopulation",
    "routesPerUpdate",
    "routeExpansionLimit",
    "nearDistance",
    "farUpdateSeconds",
    "walkSpeed",
    "destinationRestSeconds",
    "maximumTrainWait",
    "maximumParkingWait",
    "parkingSpaces",
    "initialParkedCars",
    "passengersPerCarriage",
    "drawDistance",
    "detailedDrawDistance",
    "refreshSeconds"
  ],
  "properties": {
    "targetPopulation": {
      "type": "integer",
      "minimum": 0.0,
      "maximum": 50000.0
    },
    "routesPerUpdate": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 256.0
    },
    "routeExpansionLimit": {
      "type": "integer",
      "minimum": 100.0,
      "maximum": 100000.0
    },
    "nearDistance": {
      "type": "number",
      "minimum": 30.0,
      "maximum": 3000.0
    },
    "farUpdateSeconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 30.0
    },
    "walkSpeed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 3.0
    },
    "destinationRestSeconds": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 600.0
    },
    "maximumTrainWait": {
      "type": "number",
      "minimum": 30.0,
      "maximum": 14400.0
    },
    "maximumParkingWait": {
      "type": "number",
      "minimum": 5.0,
      "maximum": 600.0
    },
    "parkingSpaces": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 500.0
    },
    "initialParkedCars": {
      "type": "integer",
      "minimum": 0.0,
      "maximum": 500.0
    },
    "passengersPerCarriage": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 250.0
    },
    "drawDistance": {
      "type": "number",
      "minimum": 100.0,
      "maximum": 5000.0
    },
    "detailedDrawDistance": {
      "type": "number",
      "minimum": 10.0,
      "maximum": 500.0
    },
    "refreshSeconds": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 120.0
    }
  }
}

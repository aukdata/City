{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pavecity generation: rivers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meanderAmplitudeWidths",
    "meanderWavelengthWidths",
    "meanderMinimumWavelength",
    "meanderGradeScale",
    "meanderSecondaryShare",
    "courseBankRiseLimit",
    "courseSearchSamples",
    "catchmentGrid",
    "minimumCatchmentCells",
    "initialWaterDepth",
    "smoothingMinimumAltitude",
    "valleyWaterDepth",
    "minimumWaterGrade",
    "mouthAltitude",
    "widthBase",
    "widthFlowScale",
    "minimumHalfWidth",
    "maximumHalfWidth",
    "segmentLength",
    "vegetationBankMargin",
    "vegetationMinimumAltitude",
    "waterEdgeMargin",
    "carveExtent",
    "bedDepth",
    "bankSlope",
    "bankBlendStart",
    "bankBlendWidth"
  ],
  "properties": {
    "meanderAmplitudeWidths": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 6.0
    },
    "meanderWavelengthWidths": {
      "type": "number",
      "minimum": 6.0,
      "maximum": 40.0
    },
    "meanderMinimumWavelength": {
      "type": "number",
      "minimum": 256.0,
      "maximum": 4000.0
    },
    "meanderGradeScale": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 0.1
    },
    "meanderSecondaryShare": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.5
    },
    "courseBankRiseLimit": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 8.0
    },
    "courseSearchSamples": {
      "type": "integer",
      "minimum": 4.0,
      "maximum": 32.0
    },
    "catchmentGrid": {
      "type": "number",
      "minimum": 64.0,
      "maximum": 1024.0
    },
    "minimumCatchmentCells": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 10000.0
    },
    "initialWaterDepth": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "smoothingMinimumAltitude": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "valleyWaterDepth": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "minimumWaterGrade": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.1
    },
    "mouthAltitude": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "widthBase": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "widthFlowScale": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "minimumHalfWidth": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 500.0
    },
    "maximumHalfWidth": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 500.0
    },
    "segmentLength": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 100.0
    },
    "vegetationBankMargin": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "vegetationMinimumAltitude": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "waterEdgeMargin": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "carveExtent": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 80.0
    },
    "bedDepth": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "bankSlope": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "bankBlendStart": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 80.0
    },
    "bankBlendWidth": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 80.0
    }
  }
}

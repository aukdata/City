# Slope (grass) - terrain transition surface
# X = cross-road, Y = up, Z = along-road
# The slope connects road height to terrain height.
# At render time, the outer edge Y is adjusted to match terrain.
# Here we model a default 45-degree slope for reference.

o inner
# inner edge (road side, at road height Y=0)
v 0.0  0.0 0.0
v 0.1  0.0 0.0
v 0.1  0.0 1.0
v 0.0  0.0 1.0
vn 0.0 1.0 0.0
vt 0.0 0.0
vt 0.1 0.0
vt 0.1 1.0
vt 0.0 1.0
f 1/1/1 2/2/1 3/3/1 4/4/1

o center
# sloped surface (0.5m wide, drops from Y=0 to Y=-0.5)
v 0.0  0.0  0.0
v 0.5 -0.5  0.0
v 0.5 -0.5  1.0
v 0.0  0.0  1.0
vn 0.707 0.707 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
f 5/5/2 6/6/2 7/7/2 8/8/2

o center_lod1
v 0.0  0.0  0.0
v 0.5 -0.5  0.0
v 0.5 -0.5  1.0
v 0.0  0.0  1.0
vn 0.707 0.707 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
f 9/9/3 10/10/3 11/11/3 12/12/3

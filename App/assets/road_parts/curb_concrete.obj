# Curb (concrete) - L-shaped cross section
# X = cross-road, Y = up, Z = along-road
# symmetric = true, so only inner is defined (outer is mirrored)

o inner
# just a thin edge cap
v 0.0 0.0  0.0
v 0.02 0.0  0.0
v 0.02 0.0  1.0
v 0.0 0.0  1.0
vn 0.0 1.0 0.0
vt 0.0 0.0
vt 0.1 0.0
vt 0.1 1.0
vt 0.0 1.0
f 1/1/1 2/2/1 3/3/1 4/4/1

o center
# top surface (0.1m wide at Y=0.15)
v 0.0 0.15 0.0
v 0.1 0.15 0.0
v 0.1 0.15 1.0
v 0.0 0.15 1.0
# road-side face (vertical, Y=0 to Y=0.15)
v 0.0 0.0  0.0
v 0.0 0.15 0.0
v 0.0 0.15 1.0
v 0.0 0.0  1.0
# outer face (vertical, Y=0 to Y=0.15)
v 0.1 0.15 0.0
v 0.1 0.0  0.0
v 0.1 0.0  1.0
v 0.1 0.15 1.0
vn 0.0 1.0 0.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
# top
f 5/5/2 6/6/2 7/7/2 8/8/2
# road-side
f 9/5/3 10/6/3 11/7/3 12/8/3
# outer-side
f 13/5/4 14/6/4 15/7/4 16/8/4

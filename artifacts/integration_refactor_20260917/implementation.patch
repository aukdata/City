-				draws << std::move(dd);
-			}
-
-			auto drawLines = [&](bool greenPass)
-			{
-				for (const auto& dd : draws)
-				{
-					if (dd.isGreen != greenPass) continue;
-					const ColorF lineC = greenPass
-						? ColorF{ 0.2, 0.95, 0.4, 0.85 }
-						: ColorF{ 0.95, 0.25, 0.15, 0.55 };
